<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Niimbot.Net</PackageId>
    <!-- Versioned independently of the app (this is a standalone NuGet — bump on the library's own
         semver cadence, not on app releases). 1.1.0 adds the D110M-v4 print task over the implicit 1.0.0;
         1.2.0 adds the NiimbotTrace diagnostic hook; 1.3.0 fixes the dpi derivation (minor, not patch —
         Dpi/PrintheadPx values change for 22 catalogue models); 1.4.0 changes print behaviour (print
         task per model from niimbluelib, RFID tag errors non-fatal, B1 Pro on D110M-v4) and adds
         PrinterErrorCodeText + the full error-code list.
         Keep <Version> + <PackageReleaseNotes> + Documentation/releases/niimbot.net/v<Version>.md in step. -->
    <Version>1.4.0</Version>
    <PackageReleaseNotes>1.4.0 - print task per model now follows niimbluelib's model-to-task table, with its protocol-version fallback (4+ uses D110M-v4); hardware-verified models are pinned. B1 Pro uses D110M-v4 and D110M-v4 jobs finish on page count (fixes a hang after printing). RFID tag errors (0x14, 0x1D, 0x22) no longer stop a print. PrinterErrorCode covers niimbluelib's full list, and the new PrinterErrorCodeText gives plain-language messages. PrinterProfiles.FromModelId takes an optional protocol version. Full notes: Documentation/releases/niimbot.net/v1.4.0.md.</PackageReleaseNotes>
    <Description>C# protocol and transport library for NIIMBOT thermal label printers. Independent of any UI or label engine.</Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Profiles\printers.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Niimbot.Net.Tests" />
  </ItemGroup>

</Project>
