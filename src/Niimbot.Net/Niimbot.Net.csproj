<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Niimbot.Net</PackageId>
    <!-- Versioned independently of the app (this is a standalone NuGet — bump on the library's own
         semver cadence, not on app releases). 1.1.0 adds the D110M-v4 print task over the implicit 1.0.0;
         1.2.0 adds the NiimbotTrace diagnostic hook.
         Keep <Version> + <PackageReleaseNotes> + Documentation/releases/niimbot.net/v<Version>.md in step. -->
    <Version>1.2.0</Version>
    <PackageReleaseNotes>1.2.0 — adds NiimbotTrace, an opt-in, dependency-free diagnostic sink that traces port enumeration, serial open/read/write, the probe, and command send/timeout for connection troubleshooting. Off by default (no sink = near-zero overhead); additive and backward-compatible. Full notes: Documentation/releases/niimbot.net/v1.2.0.md.</PackageReleaseNotes>
    <Description>C# protocol and transport library for NIIMBOT thermal label printers. Independent of any UI or label engine.</Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Profiles\printers.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Niimbot.Net.Tests" />
  </ItemGroup>

</Project>
