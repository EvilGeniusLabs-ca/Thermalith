<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Thermalith.App.Converters"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Thermalith.App.App"
             Name="Thermalith"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
        <!-- Theme-varying brushes: resolved per light/dark variant so they flip with the chosen theme. -->
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Dark">
                <!-- Text tiers (dim → strong) -->
                <SolidColorBrush x:Key="TextStrong" Color="#CCCCCC" />
                <SolidColorBrush x:Key="TextPrimary" Color="#B0B0B0" />
                <SolidColorBrush x:Key="TextSecondary" Color="#8C8C8C" />
                <SolidColorBrush x:Key="TextHint" Color="#777777" />
                <SolidColorBrush x:Key="TextInfo" Color="#88AACC" />
                <!-- Chrome surfaces -->
                <SolidColorBrush x:Key="SurfaceBar" Color="#202020" />
                <SolidColorBrush x:Key="SurfacePanel" Color="#262626" />
                <SolidColorBrush x:Key="SurfaceCanvas" Color="#3A3A3A" />
                <SolidColorBrush x:Key="SurfaceSplitter" Color="#111111" />
                <SolidColorBrush x:Key="DividerWeak" Color="#444444" />
                <!-- Icon glyph stroke + ruler chrome -->
                <SolidColorBrush x:Key="IconStroke" Color="#D0D0D0" />
                <SolidColorBrush x:Key="RulerBg" Color="#2A2A2A" />
                <SolidColorBrush x:Key="RulerTick" Color="#777777" />
                <SolidColorBrush x:Key="RulerText" Color="#AAAAAA" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="TextStrong" Color="#1E1E1E" />
                <SolidColorBrush x:Key="TextPrimary" Color="#2A2A2A" />
                <SolidColorBrush x:Key="TextSecondary" Color="#5C5C5C" />
                <SolidColorBrush x:Key="TextHint" Color="#8A8A8A" />
                <SolidColorBrush x:Key="TextInfo" Color="#2A6CA8" />
                <SolidColorBrush x:Key="SurfaceBar" Color="#E6E6E6" />
                <SolidColorBrush x:Key="SurfacePanel" Color="#F0F0F0" />
                <SolidColorBrush x:Key="SurfaceCanvas" Color="#B8B8B8" />
                <SolidColorBrush x:Key="SurfaceSplitter" Color="#C0C0C0" />
                <SolidColorBrush x:Key="DividerWeak" Color="#CFCFCF" />
                <SolidColorBrush x:Key="IconStroke" Color="#3A3A3A" />
                <SolidColorBrush x:Key="RulerBg" Color="#E6E6E6" />
                <SolidColorBrush x:Key="RulerTick" Color="#9A9A9A" />
                <SolidColorBrush x:Key="RulerText" Color="#5C5C5C" />
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>

        <conv:EqualityConverter x:Key="Eq" />
        <conv:NumericTextConverter x:Key="Num" />
        <conv:NumericValueConverter x:Key="Nz" />
        <conv:BoolToBrushConverter x:Key="ConnDot" TrueBrush="#3FB950" FalseBrush="#555" />
        <!-- Locked element → grey selection box; unlocked → the standard blue. -->
        <conv:BoolToBrushConverter x:Key="LockStroke" TrueBrush="#888888" FalseBrush="#2D7DF6" />
        <conv:BoolToCursorConverter x:Key="BusyCursor" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- Avalonia's built-in control theme. "Default" follows the OS light/dark setting. -->
        <FluentTheme />

        <!-- Material Design Icons (Pictogrammers) — project icon set, used via <mi:MaterialIcon Kind="…" />. -->
        <mi:MaterialIconStyles />

        <!-- All MDI glyphs share the theme icon colour + a default size (GitHub #4). -->
        <Style Selector="mi|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource IconStroke}" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>

        <!-- Compact square icon toggle button (justify / visible / lock / B-I-U). -->
        <Style Selector="ToggleButton.icon">
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Smaller toggle for the Elements-list rows (eye / lock). -->
        <Style Selector="ToggleButton.listicon">
            <Setter Property="Padding" Value="3" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="20" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- The default 16px icon overflows the compact list toggle; size it down. -->
        <Style Selector="ToggleButton.listicon mi|MaterialIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>

        <!-- Compact square icon button (command, not toggle) — matches ToggleButton.icon sizing. -->
        <Style Selector="Button.icon">
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Inspector section header (Position / Alignment / Font / …). -->
        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>

        <!-- Numeric entry: up/down spinner on the right, clamps to Min/Max, stretches to its cell. -->
        <Style Selector="NumericUpDown">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Increment" Value="1" />
            <Setter Property="FormatString" Value="0.###" />
            <Setter Property="ClipValueToMinMax" Value="True" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <!-- Insert palette button: icon to the left of the label, full-width. -->
        <Style Selector="Button.insert">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="2" />
        </Style>
    </Application.Styles>

</Application>
